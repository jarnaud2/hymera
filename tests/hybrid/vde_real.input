# Realistic VDE run: inputs/hybrid.input on one Perlmutter GPU node (4 ranks, 4 A100),
# chained over 4 h allocations by restarting from the last numbered snapshot.
# Changes from tests/hybrid/vde_full.input:
#   ParticleSeed: seed runaway current 150 A (was the 15 kA default); the initial
#     E is lowered by current_fraction eta J with current_fraction = 1e-5 = 150 A /
#     15 MA (the default 1e-3 matches a 15 kA seed); 2^16 seed particles (512 per
#     block, 128 blocks); RandomRemove cap stays 2^20
#   parthenon/time: MHD step a quarter of before, 0.27 ms (was 1.08 ms);
#     restart and field outputs at every MHD step
# Kept: rk4 hRK = 2e-7, fast large-angle sampler, gamma_min floor 1.02, field-plot
#   grid 100 x 200, no time cap (tlim = 1 s).
<parthenon/job>
problem_id = vde_real

<parthenon/mesh>
nx1 = 512
x1min = -2.0
x1max = 2.0
ix1_bc = periodic
ox1_bc = periodic
task_collection_timeout_in_seconds = 28000

nx2 = 256
x2min = -2.0
x2max = 2.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

# How many meshblocks to use in a premade default kernel.
# A value of <1 means use the whole mesh.
pack_size = -1

<parthenon/meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<MHD_Config>
input_folder=../../inputs/mhd
ic_binary_path=X_vde.petscbin
ic_binary_load=1

<Geometry>
input_file=../../inputs/AxisSymmetricGeometry.dat

<parthenon/time>
dt_force = 0.00027
tlim = 1.0
<Time>
nCD = 10
nPR = 1
dtLA_over_tauC = 1e-4

<ParticleSeed>
num_particles_per_block = 512
current = 150.0
current_fraction = 1.0e-5
MaxParticles = 1048576
rng_seed = 1234
pmin = 10.0
pmax = 20.0
ximin = 0.85
ximax = 0.95

<Simulation>
integrator=rk4
hRK=2e-7
verbosity=info
EnableLargeAngleCollisions=1
EnableSmallAngleCollisions=1
EnableComputeConservedQuantities=0
atol=1e-10
rtol=1e-9

<Plasma>
ZI = 3.0 # or 2.0
fI = 0.1

<Reference>
Te0 = 10.0
B0 = 5.3

<Collisions>
aI = 0.29197

<parthenon/output8>
file_type = rst
dt = 0.00027

<parthenon/output2>
file_type = hdf5
write_xdmf = false # Determines whether xdmf annotations are output
# nonexistent variables/swarms are ignored
swarms = particles  # Particle swarms
particles_variables = x, y, z, particle.p, particle.xi, particle.R, particle.phi, particle.Z, particle.weight, particle.will_scatter, particle.secondary_index, particle.status

dt = 0.00027
file_number_width = 6 # default: 5
use_final_label = true # default: true

<Hybrid>
midplane_profile = 1
update_gamma_min = 1
gamma_min_floor = 1.02
la_sampler = fast

<Output>
NR_plot = 100
NZ_plot = 200
