# Pilot for the corrected hybrid: tests/hybrid/vde_real.input on one Perlmutter GPU
# node (4 ranks, 4 A100), one 4 h allocation from t = 0, after
#   1e11e0e  the runaway current passed to MHD is its time average over the step
#   ad33856  the momentum boundary uses the field at the time within the step
# Changes from tests/hybrid/vde_real.input:
#   Hybrid: gamma_min floor 1.001 (was 1.02); jre_map = 1 writes the 2-D runaway
#     current passed to MHD (/profiles/jre_c<cycle>) at every output
<parthenon/job>
problem_id = vde_pilot3

<parthenon/mesh>
nx1 = 512
x1min = -2.0
x1max = 2.0
ix1_bc = periodic
ox1_bc = periodic
task_collection_timeout_in_seconds = 28000

nx2 = 256
x2min = -2.0
x2max = 2.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

# How many meshblocks to use in a premade default kernel.
# A value of <1 means use the whole mesh.
pack_size = -1

<parthenon/meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<MHD_Config>
input_folder=../../inputs/mhd
ic_binary_path=X_vde.petscbin
ic_binary_load=1

<Geometry>
input_file=../../inputs/AxisSymmetricGeometry.dat

<parthenon/time>
dt_force = 0.00027
tlim = 1.0
<Time>
nCD = 10
nPR = 1
dtLA_over_tauC = 1e-4

<ParticleSeed>
num_particles_per_block = 512
current = 150.0
current_fraction = 1.0e-5
MaxParticles = 1048576
rng_seed = 1234
pmin = 10.0
pmax = 20.0
ximin = 0.85
ximax = 0.95

<Simulation>
integrator=rk4
hRK=2e-7
verbosity=info
EnableLargeAngleCollisions=1
EnableSmallAngleCollisions=1
EnableComputeConservedQuantities=0
atol=1e-10
rtol=1e-9

<Plasma>
ZI = 3.0 # or 2.0
fI = 0.1

<Reference>
Te0 = 10.0
B0 = 5.3

<Collisions>
aI = 0.29197

<parthenon/output8>
file_type = rst
dt = 0.00027

<parthenon/output2>
file_type = hdf5
write_xdmf = false # Determines whether xdmf annotations are output
# nonexistent variables/swarms are ignored
swarms = particles  # Particle swarms
particles_variables = x, y, z, particle.p, particle.xi, particle.R, particle.phi, particle.Z, particle.weight, particle.will_scatter, particle.secondary_index, particle.status

dt = 0.00027
file_number_width = 6 # default: 5
use_final_label = true # default: true

<Hybrid>
midplane_profile = 1
update_gamma_min = 1
gamma_min_floor = 1.001
la_sampler = fast
jre_map = 1

<Output>
NR_plot = 100
NZ_plot = 200
